# 复制为本目录的 .env 后再改。本文件进 git，不要写入密钥。
# 布尔：true / false（也认 1、yes、on 与 0、no、off）。空值等于没写，走 config.py 缺省。
# 下面未注释的项是当前工程正在用的值。注释掉的项本机 .env 已按 config.py 缺省写上，换机器或端口时再改。

# DeepSeek API 密钥。只放在本机 .env。留空时模型调用会报没有密钥。
DEEPSEEK_API_KEY=

# 对话、规划所用模型名。代码缺省 deepseek-chat。
UE_LLM_MODEL=deepseek-flash

# 模型 API 地址（OpenAI 兼容）。代码缺省 https://api.deepseek.com。
# UE_LLM_BASE_URL=

# 评测专用 API 地址。没写跟随 UE_LLM_BASE_URL。
# UE_EVAL_BASE_URL=

# 是否允许改蓝图 Graph 连线。false 时不改图，只把步骤写入 Plan。代码缺省 false。
UE_ALLOW_BLUEPRINT=true

# 是否允许改材质图节点与连线。false 时走人工清单。代码缺省 false。
UE_ALLOW_MATERIAL=true

# 是否允许改 UMG / Widget 蓝图。代码缺省 false。
UE_ALLOW_UMG=true

# 是否允许改动画蓝图连线。代码缺省 false。
UE_ALLOW_ANIM=true

# 是否允许改 Niagara 连线。代码缺省 false。
UE_ALLOW_NIAGARA=true

# 是否允许改行为树、黑板、StateTree、EQS、感知、导航。代码缺省 false。
UE_ALLOW_AI=true

# 是否允许 Monolith 其余命名空间的非只读 action。official 后端不因此放行官方工具。代码缺省 false。
UE_ALLOW_MONOLITH_WRITE=true

# 是否允许 editor.run_python（编辑器内 Python：万能但有越权面）。代码缺省 false。
# 任务上显式写 allow_python: false 的仍然拒绝；这个开关只给任务上没写这个键的路径当缺省。
UE_ALLOW_PYTHON=true

# 任务没写 save 时是否保存当前关卡。false 只改内存。代码缺省 true。
UE_DEFAULT_SAVE=true

# 任务没写 pie 时是否进入 PIE。false 不开 PIE。代码缺省 true。
UE_DEFAULT_PIE=true

# 编辑器后端。official：官方 MCP。monolith：Monolith 插件。没写等于 official。
UE_EDITOR_BACKEND=monolith

# 仅 backend=monolith 时的编辑器 MCP 地址。代码缺省 http://127.0.0.1:9316/mcp。
UE_MONOLITH_URL=http://127.0.0.1:9316/mcp

# Monolith 说明书与离线查询的源码目录。已加载的插件在工程 Plugins/Monolith。
UE_MONOLITH_ROOT=E:\UEProject\AIWork\RAG\monolith-master

# 官方 MCP 地址。backend=official 时使用。代码缺省 http://127.0.0.1:8000/mcp。
# UE_MCP_URL=http://127.0.0.1:8000/mcp

# UnrealEditor-Cmd.exe 的绝对路径。没写时用 config.py 的本机缺省，并从同目录找 UnrealEditor.exe。
# UE_EDITOR_CMD=D:\UnrealEngine\UE_5.8\Engine\Binaries\Win64\UnrealEditor-Cmd.exe

# 引擎根目录。没写时从 UE_EDITOR_CMD 向上三级推断。编译使用 Engine/Build/BatchFiles/Build.bat。
# UE_ENGINE_ROOT=D:\UnrealEngine\UE_5.8

# 目标工程的 .uproject。没写时用 AIAgentProject.uproject。
# UE_PROJECT=E:\UEProject\AIWork\AIAgentProject\AIAgentProject.uproject

# C++ 模块源码根。没写时用 Source/AIAgentProject。
# UE_SOURCE_ROOT=E:\UEProject\AIWork\AIAgentProject\Source\AIAgentProject

# real：真的调编辑器与编译。mock：裁判与执行走假数据，只给测试用。代码缺省 real。
# UE_EXEC_MODE=real

# 裁判与编译等待的秒数。代码缺省 300。
# UE_MCP_TIMEOUT=300

# 受控求解扇（solve）：表外需求的第二条路。缺省 false，人开了才走。预算与白名单见 README。
# UE_SOLVER_ENABLED=false
# UE_SOLVER_EDITOR_CALLS=8
# UE_SOLVER_BUILD_ROUNDS=3
# UE_SOLVER_MODEL_CALLS=6
# UE_SOLVER_NAMESPACES=editor,mesh,niagara,blueprint,material

# 单次普通 MCP 调用的超时秒数。代码缺省 60。
# UE_MCP_CALL_TIMEOUT=60
