{
  "tools": [
    {
      "name": "query_actor",
      "summary": "适用：按名字读当前关卡里唯一 Actor 的位置。不适用：零个或多个同名 Actor，就停。",
      "permission": "读",
      "timeout": 60,
      "retryable": false,
      "input_schema": {
        "type": "object",
        "properties": {"name": {"type": "string", "maxLength": 200, "description": "Actor 名字，用于在当前关卡里定位唯一实例。"}},
        "required": ["name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "name": {"type": "string"},
          "ref_path": {"type": "string"},
          "location": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"},
              "z": {"type": "number"}
            },
            "required": ["x", "y", "z"]
          }
        },
        "required": ["ok", "name", "ref_path", "location"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"}
        },
        "required": ["ok", "error"]
      }
    },
    {
      "name": "query_blueprint",
      "summary": "适用：读一张已有蓝图的图名、变量名和事件名，不改图。不适用：图不存在或需要改图的场合。",
      "permission": "读",
      "timeout": 60,
      "retryable": false,
      "input_schema": {
        "type": "object",
        "properties": {"ref_path": {"type": "string", "maxLength": 300, "description": "蓝图的 /Game 路径，如 /Game/BP_Gun.BP_Gun。"}},
        "required": ["ref_path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "ref_path": {"type": "string"},
          "graphs": {"type": "array", "items": {"type": "string"}},
          "variables": {"type": "array", "items": {"type": "string"}},
          "events": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["ok", "ref_path", "graphs", "variables", "events"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"}
        },
        "required": ["ok", "error"]
      }
    },
    {
      "name": "find_asset",
      "summary": "适用：在 /Game 里按名字找唯一资产。不适用：不唯一的资产名，就停。",
      "permission": "读",
      "timeout": 60,
      "retryable": false,
      "input_schema": {
        "type": "object",
        "properties": {"name": {"type": "string", "maxLength": 200, "description": "资产名，在 /Game 里查找唯一匹配。"}},
        "required": ["name"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "name": {"type": "string"},
          "ref_path": {"type": "string"}
        },
        "required": ["ok", "name", "ref_path"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"},
          "candidates": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["ok", "error"]
      }
    },
    {
      "name": "build_project",
      "summary": "适用：关掉编辑器后编译 AIAgentProjectEditor，并留下错误原文。不适用：需要编辑器内编译的场合。",
      "permission": "编译",
      "timeout": 300,
      "retryable": true,
      "input_schema": {"type": "object", "properties": {}},
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "summary": {"type": "string"},
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {"type": "string"},
                "line": {"type": "integer"},
                "message": {"type": "string"}
              },
              "required": ["file", "line", "message"]
            }
          }
        },
        "required": ["ok", "summary", "errors"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"},
          "errors": {"type": "array"}
        },
        "required": ["ok", "error"]
      }
    },
    {
      "name": "run_automation_test",
      "summary": "适用：按过滤器跑 Automation，失败数不是 0 就不算通过。不适用：不带过滤器的全量跑法。",
      "permission": "测试",
      "timeout": 300,
      "retryable": true,
      "input_schema": {
        "type": "object",
        "properties": {"filter": {"type": "string", "maxLength": 200, "description": "Automation 过滤器，只跑匹配的测试。"}},
        "required": ["filter"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "summary": {"type": "string"}
        },
        "required": ["ok", "summary"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"}
        },
        "required": ["ok", "error"]
      }
    },
    {
      "name": "get_build_error",
      "summary": "适用：读上一次 build_project 留下的编译错误。不适用：没有留下记录时，就停。",
      "permission": "读",
      "timeout": 60,
      "retryable": false,
      "input_schema": {"type": "object", "properties": {}},
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "summary": {"type": "string"},
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {"type": "string"},
                "line": {"type": "integer"},
                "message": {"type": "string"}
              },
              "required": ["file", "line", "message"]
            }
          }
        },
        "required": ["ok", "summary", "errors"]
      },
      "error_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "error": {"type": "string"}
        },
        "required": ["ok", "error"]
      }
    }
  ]
}
