# agent/run_agent.py
import os
import sys
import uuid
import time
from datetime import datetime

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

from langgraph.checkpoint.sqlite import SqliteSaver
from agent.graph import builder


REQUIRE_BUILD = os.getenv("REQUIRE_BUILD", "false").lower() == "true"

NODE_ICONS = {
    "retrieve": "🔍",
    "plan":     "🧠",
    "execute":  "⚙️ ",
    "build":    "🔨",
    "test":     "🧪",
    "observe":  "👀",
    "fix":      "🔧",
}


def build_initial_state(user_query: str) -> dict:
    return {
        "messages": [{"role": "user", "content": user_query}],
        "user_query": user_query,
        "available_tools": [],
        "tool_calls": [],
        "tool_results": [],
        "retry_count": 0,
        "is_completed": False,
        "require_build": REQUIRE_BUILD,
        "build_result": "",
        "test_result": "",
        "fix_plan": "",
        "final_success": False,
    }


def print_banner(thread_id: str, user_query: str):
    print("╔" + "═" * 62 + "╗")
    print("║" + " 🚀 LangGraph W7 · Streaming 模式 ".center(52) + "║")
    print("╚" + "═" * 62 + "╝")
    print(f"  🆔 thread_id      : {thread_id}")
    print(f"  🔧 require_build  : {REQUIRE_BUILD}")
    print(f"  💬 user_query     : {user_query}")
    print("─" * 64)


def print_final_state(final_state: dict, elapsed: float):
    print("\n" + "═" * 64)
    print("📊 最终状态")
    print("═" * 64)
    ok = final_state.get("final_success", False)
    print(f"  完成状态 : {'✅ 成功' if ok else '❌ 失败 / 未完成'}")
    print(f"  重试次数 : {final_state.get('retry_count', 0)}")
    print(f"  总耗时   : {elapsed:.2f} s")
    if final_state.get("build_result"):
        print(f"  Build    : {final_state['build_result']}")
    if final_state.get("test_result"):
        print(f"  Test     : {final_state['test_result']}")
    last = final_state["messages"][-1]
    content = last.get("content", "") if isinstance(last, dict) else str(last)
    print(f"\n  最终消息:\n  {content}")
    print("═" * 64)


if __name__ == "__main__":
    if REQUIRE_BUILD:
        user_query = "Raise the Z-coordinate of all enemy spawn points in the scene by 100 and verify."
    else:
        user_query = "Move the SkyLight_0 actor up by 100 units and verify."

    thread_id = datetime.now().strftime("dev_%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:4]

    config = {
    "configurable": {"thread_id": thread_id},
    "recursion_limit": 100,   # ⭐ 硬兜底：任何图最多跑 50 步
}

    print_banner(thread_id, user_query)
    initial_state = build_initial_state(user_query)

    final_state = None
    step = 0
    t0 = time.time()

    with SqliteSaver.from_conn_string("agent_checkpoints.db") as checkpointer:
        graph = builder.compile(checkpointer=checkpointer)

        # ⭐ 双模式订阅：
        #   updates —— 每次节点完成，输出「哪个节点、更新了哪些字段」
        #   values  —— 每次节点完成，输出「完整 state 快照」，用于最后取最终状态
        for mode, chunk in graph.stream(
            initial_state,
            config=config,
            stream_mode=["updates", "values"],
        ):
            if mode == "updates":
                if not chunk:
                    continue
                for node_name, update in chunk.items():
                    if update is None:      # ⭐ END 哨兵，跳过
                        continue
                    step += 1
                    icon = NODE_ICONS.get(node_name, "• ")
                    keys = [k for k in update.keys() if k != "messages"]
                    suffix = ", ".join(keys) if keys else "messages"
                    print(f"\n[{step:02d}] {icon} {node_name:<8} ← {suffix}")
            elif mode == "values":
                final_state = chunk

    elapsed = time.time() - t0
    if final_state is None:
        print("\n⚠️ 未捕获到最终状态")
    else:
        print_final_state(final_state, elapsed)